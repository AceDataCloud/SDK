  "gpt-image": {
    "path": "/openai/images/generations",
    "task_path": "/openai/tasks",
    "schema": {
      "type": "object",
      "required": [
        "prompt",
        "model"
      ],
      "properties": {
        "n": {
          "rank": 20,
          "type": "integer",
          "default": 1,
          "example": 1,
          "maximum": 10,
          "minimum": 1,
          "description": "The number of images to be generated ranges from 1 to 10. `dall-e-3` is fixed at `1`. The `dall-e-2`, `gpt-image-1` / `gpt-image-1.5` / `gpt-image-2` series, as well as the `nano-banana` / `nano-banana-2-lite` / `nano-banana-2` / `nano-banana-pro` series all support `n>1`: they will return and charge for the corresponding number of images. Note that `response_format=b64_json` only supports `n=1`, and for `n>1`, please use the default URL return. If some images fail to generate, only the successful parts will be returned and charged."
        },
        "size": {
          "rank": 30,
          "type": "string",
          "default": "auto",
          "example": "1024x1024",
          "pattern": "^(auto|\\d+x\\d+)$",
          "nullable": true
        },
        "async": {
          "rank": 101,
          "type": "boolean",
          "description": "Whether to process in asynchronous mode. When set to `true`, the interface immediately returns `task_id`, without the need to provide `callback_url`, and then the result can be obtained by polling the corresponding task query interface; if `callback_url` is also provided, the result will be pushed to that callback address."
        },
        "model": {
          "enum": [
            "dall-e-2",
            "dall-e-3",
            "gpt-image-1",
            "gpt-image-1.5",
            "gpt-image-2",
            "gpt-image-2.5-flare",
            "gpt-image-2.5-flare:reverse",
            "gpt-image-2.5-flare:official",
            "gpt-image-2.5-sunburst",
            "gpt-image-2.5-sunburst:reverse",
            "gpt-image-2.5-sunburst:official",
            "gpt-image-2:reverse",
            "gpt-image-2:official",
            "nano-banana",
            "nano-banana-2-lite",
            "nano-banana-2",
            "nano-banana-2.1",
            "nano-banana-pro",
            "gpt-image-2.6-flare",
            "gpt-image-2.6-flare:reverse",
            "gpt-image-2.6-flare:official",
            "gpt-image-2.6-sunburst",
            "gpt-image-2.6-sunburst:reverse",
            "gpt-image-2.6-sunburst:official"
          ],
          "rank": 1,
          "type": "string",
          "description": "Models for image generation. Supports OpenAI's `dall-e-2`, `dall-e-3`, `gpt-image-1` / `gpt-image-1.5` / `gpt-image-2` series, as well as Google's `nano-banana` / `nano-banana-2-lite` / `nano-banana-2` / `nano-banana-2.1` / `nano-banana-pro`. The parameters `size`, `quality`, `style`, `background`, `output_format`, `moderation`, and `response_format` supported by different models vary, please refer to the description of each field for details. `gpt-image-2` offers two optional suffix variants: `gpt-image-2:official` (official channel, stable and compliant, supports higher resolution, billed at double the price per image) and `gpt-image-2:reverse` (equivalent to the default `gpt-image-2`, offering better cost performance)."
        },
        "style": {
          "enum": [
            "vivid",
            "natural"
          ],
          "type": "string",
          "default": "vivid",
          "example": "vivid",
          "description": "The style of `dall-e-3`: `vivid` (hyper-realistic/dramatic) or `natural` (more naturally neutral)."
        },
        "prompt": {
          "enum": [
            "A cute baby sea otter",
            "A wooden bookshelf consisting of three shelves: on the top shelf one book, the second shelf three books, and the bottom shelf seven books.",
            "Cinematic minimal portrait of a solitary man standing in an intense orange-to-red gradient environment, strong silhouette lighting, deep shadow contrast, reflective glossy floor, symmetrical composition.",
            "Symmetrical design featuring two elegant blue peacocks with detailed feather patterns, surrounded by blue floral elements, intricate vintage botanical ornament, soft beige background, decorative art illustration.",
            "Avant-garde sports fashion advertisement, oversized basketball posed like a monumental sculpture, female athlete reclining across the ball's curved surface, giant word 'ELEVATE' in bold typography behind, burnt orange studio backdrop, glossy reflective floor.",
            "High-fashion surrealist poster for Rolex. Deep emerald green minimalist studio with polished reflective floor. A massive Rolex watch standing upright like a monument; a male model in tailored dark green suit leans casually against the watch face, wearing a matching Rolex.",
            "Ultra-realistic product photography of a rich strawberry soft-serve ice cream in a crispy waffle cone, clean modern premium aesthetic, soft serve vibrant natural pink, sculpted swirl with curled peak, lightly topped with strawberry dust.",
            "Hyper-realistic UI/UX mockup on a slim modern laptop on a minimal wooden desk with soft natural daylight; clean SaaS dashboard with elegant typography, glassmorphism cards, smooth gradients, subtle drop shadows, charts, sidebar navigation, macOS-style window frame.",
            "9:16 vertical Korean idol portrait photoshoot, 3x3 grid (nine frames), same person in all images, consistent facial features and styling, soft black mist filter effect, lowered contrast, blooming highlights, subtle glow around light sources.",
            "Mobile phone photo, old CCD camera aesthetic, harsh flash, grainy, dim messy indoor lighting, candid snapshot feeling, slight motion blur.",
            "Create a science fiction movie poster.",
            "以中国连环画（小人书）的风格帮我绘制大闹天宫",
            "新中式水墨山水海报，竖版9:16构图，东方极简美学风格，大面积留白，主题是春岚一叶红"
          ],
          "rank": 10,
          "type": "string",
          "example": "A cute baby sea otter",
          "description": "Text description of the required image. The GPT image model supports up to 32,000 characters, `dall-e-2` supports up to 1,000 characters, and `dall-e-3` supports up to 4,000 characters. A selection of example prompts is provided in the dropdown list (source: [EvoLinkAI/awesome-gpt-image-2-prompts](https://github.com/EvoLinkAI/awesome-gpt-image-2-prompts), Apache-2.0 license); you can also enter your own."
        },
        "quality": {
          "enum": [
            "auto",
            "high",
            "medium",
            "low",
            "xhigh",
            "max",
            "hd",
            "standard"
          ],
          "rank": 40,
          "type": "string",
          "default": "auto",
          "example": "auto",
          "description": "Image quality. GPT Image models support `auto` (default), `low`, `medium`, `high`. GPT Image 2.5 and 2.6 Flare/Sunburst (including `:official` variants) also support `xhigh` and `max`. Official-channel requests are billed by actual token usage. `dall-e-3` supports `hd` or `standard`; `dall-e-2` only supports `standard`."
        },
        "background": {
          "enum": [
            "transparent",
            "opaque",
            "auto"
          ],
          "type": "string",
          "default": "auto",
          "description": "Set the background opacity for the GPT image model. The optional values are `transparent`, `opaque`, or `auto` (default). When selecting `transparent`, please use an output format that supports the Alpha channel (png/webp)."
        },
        "moderation": {
          "enum": [
            "low",
            "auto"
          ],
          "type": "string",
          "default": "auto",
          "description": "The content review levels of the GPT image model. `low` will relax the filtering strength; `auto` uses the default policy."
        },
        "callback_url": {
          "rank": 100,
          "type": "string",
          "description": "Optional callback URL. Once provided, the API will immediately return `task_id` and will push the results to that URL via a POST request after the image generation is complete. The callback payload contains `task_id`, `trace_id`, `success` (boolean), and the complete response data or error information."
        },
        "output_format": {
          "enum": [
            "png",
            "jpeg",
            "webp",
            "gif"
          ],
          "type": "string",
          "default": "png"
        },
        "partial_images": {
          "type": "integer",
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "description": "The number of intermediate images sent during the streaming process (0-3). `0` indicates that the final image is returned directly in one event."
        },
        "response_format": {
          "enum": [
            "url",
            "b64_json"
          ],
          "type": "string",
          "default": "url",
          "example": "url",
          "nullable": true,
          "description": "The return format for `dall-e-2` / `dall-e-3` images: `url` or `b64_json`. The GPT image model does not support this parameter (always returns base64 encoded)."
        },
        "output_compression": {
          "type": "integer",
          "default": 100,
          "maximum": 100,
          "minimum": 0,
          "description": "The compression level (0-100%) of the GPT image model when using `webp` or `jpeg` output formats."
        },
        "frame_count": {
          "type": "integer",
          "minimum": 2,
          "example": 9,
          "description": "Openai Images Generations Frame Count",
          "maximum": 16
        },
        "frame_duration_ms": {
          "type": "integer",
          "minimum": 20,
          "example": 200,
          "description": "Openai Images Generations Frame Duration Ms",
          "maximum": 655350
        },
        "complexity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "description": "Openai Images Generations Complexity"
        }
      }
    },
    "source_sha": "6ebdd2274bbe27c1138e8b8355dfa0cd5a8275a3",
    "source_url": "https://github.com/AceDataCloud/SDK/blob/6ebdd2274bbe27c1138e8b8355dfa0cd5a8275a3/scripts/specs/8f01fe72-8a3e-4872-8d8d-330cde179b3a.json"
  },
  "nano-banana": {
    "path": "/nano-banana/images",
    "task_path": "/nano-banana/tasks",
    "schema": {
      "type": "object",
      "required": [
        "action",
        "prompt"
      ],
      "properties": {
        "action": {
          "enum": [
            "generate",
            "edit"
          ],
          "rank": 0,
          "type": "string",
          "example": "generate",
          "description": "$t(nano_banana_images_action)"
        },
        "model": {
          "rank": 10,
          "type": "string",
