        "model": {
          "enum": [
            "dall-e-2",
            "dall-e-3",
            "gpt-image-1",
            "gpt-image-1.5",
            "gpt-image-2",
            "gpt-image-2.5-flare",
            "gpt-image-2.5-flare:official",
            "gpt-image-2.5-sunburst",
