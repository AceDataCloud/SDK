            "nano-banana-pro"
          ],
          "type": "string",
          "rank": 1,
          "description": "$t(openai_images_generations_model)"
        },
        "moderation": {
          "enum": [
            "low",
            "auto"
          ],
          "type": "string",
          "default": "auto",
          "description": "$t(openai_images_generations_moderation)"
