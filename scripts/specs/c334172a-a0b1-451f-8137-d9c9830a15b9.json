{"info": {"title": "Digital Human Voices", "version": "1.0.0", "description": "Clone a voice from a short clean sample into a reusable voice_id for TTS in /digital-human/videos."}, "paths": {"/digital-human/voices": {"post": {"summary": "Digital Human voice-clone API \u2014 upload an audio sample to clone a custom voice for speech synthesis.", "security": [{"bearerAuth": []}], "responses": {"200": {"content": {"application/json": {"schema": {"type": "object", "example": {"state": "succeed", "success": true, "task_id": "...", "trace_id": "...", "voice_id": "f754a190e26c"}}}}, "description": "OK"}, "400": {"content": {"application/json": {"schema": {"type": "object", "example": {"error": {"code": "bad_request", "message": "audio_url is required"}, "trace_id": "..."}}}}, "description": "Bad request"}, "401": {"content": {"application/json": {"schema": {"type": "object", "example": {"error": {"code": "invalid_token", "message": "The specified token is invalid or wrong."}, "trace_id": "..."}}}}, "description": "Unauthorized"}, "500": {"content": {"application/json": {"schema": {"type": "object", "example": {"error": {"code": "api_error", "message": "voice clone (asr) failed"}, "trace_id": "..."}}}}, "description": "Server error"}}, "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["audio_url"], "properties": {"lang": {"enum": ["zh", "en"], "type": "string", "default": "zh"}, "name": {"type": "string", "description": "Optional label."}, "async": {"type": "boolean", "default": false}, "audio_url": {"type": "string", "example": "https://cdn1.suno.ai/ec13e502-d043-4eb2-92ee-e900c6da69d1.wav", "description": "Public URL of a clean 10-20s voice sample."}}}}}, "required": true}}}}, "openapi": "3.0.1", "servers": [{"url": "https://api.acedata.cloud"}], "components": {"securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}}}}