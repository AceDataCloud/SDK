{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://api.acedata.cloud",
      "description": "Server Description Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/audio/speech": {
      "post": {
        "summary": "Openai Audio Speech",
        "description": "Openai Audio Speech",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "example": {
                  "model": "tts-1-hd",
                  "input": "Hello from AceData Cloud.",
                  "voice": "nova",
                  "response_format": "mp3"
                },
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "tts-1",
                      "tts-1-hd"
                    ],
                    "default": "tts-1-hd",
                    "description": "Openai Audio Speech Model"
                  },
                  "input": {
                    "type": "string",
                    "description": "Openai Audio Speech Input"
                  },
                  "voice": {
                    "type": "string",
                    "enum": [
                      "alloy",
                      "echo",
                      "fable",
                      "onyx",
                      "nova",
                      "shimmer"
                    ],
                    "default": "alloy",
                    "description": "Openai Audio Speech Voice"
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "mp3",
                      "opus",
                      "aac",
                      "flac",
                      "wav",
                      "pcm"
                    ],
                    "default": "mp3",
                    "description": "Openai Audio Speech Response Format"
                  },
                  "speed": {
                    "type": "number",
                    "default": 1.0,
                    "description": "Openai Audio Speech Speed"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Openai Audio Speech Response 200",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "Openai Audio Speech Response 200 Audio"
                }
              }
            }
          },
          "400": {
            "description": "Response 400",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "bad_request",
                      "message": "Please provide a non-empty input text to synthesize."
                    },
                    "trace_id": "2efa9340-b21b-4e26-9e14-4aac95f343ab"
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Response 401",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "authentication_failed",
                      "message": "The token is invalid."
                    },
                    "trace_id": "2efa9340-b21b-4e26-9e14-4aac95f343ab"
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "403": {
            "description": "Response 403",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "used_up",
                      "message": "Your balance is not enough."
                    },
                    "trace_id": "2efa9340-b21b-4e26-9e14-4aac95f343ab"
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "429": {
            "description": "Response 429",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "too_many_requests",
                      "message": "Too many requests, please try again later."
                    },
                    "trace_id": "2efa9340-b21b-4e26-9e14-4aac95f343ab"
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "500": {
            "description": "Response 500",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "api_error",
                      "message": "Internal server error, please contact support."
                    },
                    "trace_id": "2efa9340-b21b-4e26-9e14-4aac95f343ab"
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "operationId": "createV1AudioSpeech"
      }
    }
  }
}
