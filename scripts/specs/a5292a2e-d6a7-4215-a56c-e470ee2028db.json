"type":"string"},"status":{"type":"string"},"type":{"enum":["message"],"type":"string"}},"required":["type","role","content"],"type":"object"},"ResponsesResponse":{"additionalProperties":true,"properties":{"created_at":{"type":"integer"},"error":{"additionalProperties":true,"nullable":true,"type":"object"},"id":{"type":"string"},"model":{"type":"string"},"object":{"enum":["response"],"type":"string"},"output":{"items":{"$ref":"#/components/schemas/ResponsesOutputItem"},"type":"array"},"output_text":{"type":"string"},"status":{"enum":["completed","failed","in_progress","incomplete","queued","cancelled"],"type":"string"},"usage":{"allOf":[{"$ref":"#/components/schemas/ResponsesUsage"}],"nullable":true}},"required":["id","object","status","model","output"],"type":"object"},"ResponsesStreamEvent":{"additionalProperties":true,"properties":{"delta":{"type":"string"},"item":{"$ref":"#/components/schemas/ResponsesOutputItem"},"output_index":{"type":"integer"},"response":{"$ref":"#/components/schemas/ResponsesResponse"},"type":{"description":"Openapi.Ed972A38Ecef4Fcbaf33750De42D25Dc.Type.Fab6416D3441","type":"string"}},"required":["type"],"type":"object"},"ResponsesTool":{"discriminator":{"propertyName":"type"},"oneOf":[{"$ref":"#/components/schemas/ResponsesCustomTool"},{"$ref":"#/components/schemas/ResponsesFunctionTool"},{"$ref":"#/components/schemas/ResponsesNamespaceTool"},{"$ref":"#/components/schemas/ResponsesOpenTool"}]},"ResponsesUsage":{"additionalProperties":true,"properties":{"input_tokens":{"type":"integer"},"input_tokens_details":{"additionalProperties":true,"type":"object"},"output_tokens":{"type":"integer"},"output_tokens_details":{"additionalProperties":true,"type":"object"},"total_tokens":{"type":"integer"}},"required":["input_tokens","output_tokens","total_tokens"],"type":"object"}},"securitySchemes":{"bearerAuth":{"description":"API token from https://platform.acedata.cloud","scheme":"bearer","type":"http"}}},"info":{"description":"API reference for OpenAI generation on Ace Data Cloud.","title":"OpenAI generation","version":"1.0.0"},"openapi":"3.0.0","paths":{"/v1/realtime":{"get":{"description":"Low-latency speech-to-speech over a WebSocket using the OpenAI Realtime GA event protocol. Connect with `wss://api.acedata.cloud/v1/realtime?model=gpt-realtime` and an `Authorization: Bearer <token>` header (browsers pass `realtime, acedata-token.<token>` via `Sec-WebSocket-Protocol`). Client and server exchange Realtime JSON events (`session.update`, `input_audio_buffer.append`, `response.create`, `response.output_audio.delta`, `response.done`, ...). The relay fixes the connection model, pcm16 @ 24kHz mono transport, output voice, transcription, and noise-reduction settings; choose the model and voice when connecting. A `session.update` may change GA fields `instructions`, `tools`, `tool_choice`, `output_modalities`, `include`, `prompt`, `reasoning`, `parallel_tool_calls`, `tracing`, `truncation`, may lower `max_output_tokens` from the platform cap, and may set `audio.input.turn_detection` to `null`, `server_vad`, or `semantic_vad` with their documented controls. It preserves the optional client `event_id`. Attempts to change fixed fields, exceed the output-token cap, use legacy beta fields, or send unknown fields return a recoverable `error` event; the top-level `event_id` uniquely identifies the server error event, while `error.event_id` contains the original client event ID when supplied, and `error.param` identifies the rejected field. The WebSocket remains open. Billed per assistant turn from `response.done.usage` (audio and text tokens priced separately).","operationId":"openaiRealtime","parameters":[{"description":"Realtime model to use. Use gpt-realtime-2.1 for best quality or gpt-realtime-2.1-mini for lower cost. Older stable model IDs remain available for compatibility.","in":"query","name":"model","required":true,"schema":{"default":"gpt-realtime-2.1","enum":["gpt-realtime-2.1","gpt-realtime-2.1-mini","gpt-realtime-2","gpt-realtime","gpt-realtime-mini"],"type":"string"}},{"description":"Output voice selected when the connection is established.","in":"query","name":"voice","required":false,"schema":{"default":"alloy","enum":["alloy","ash","ballad","coral","echo","sage","shimmer","verse","marin","cedar"],"type":"string"}}],"responses":{"101":{"description":"Switching Protocols — WebSocket established."},"401":{"description":"Unauthorized — missing or invalid bearer token."},"403":{"description":"Insufficient balance."}},"summary":"Openai Realtime"}}},"servers":[{"description":"Ace Data Cloud API","url":"https://api.acedata.cloud"}]}
