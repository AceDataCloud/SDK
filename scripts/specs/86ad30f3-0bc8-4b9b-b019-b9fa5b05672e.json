        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "rank": 10,
                    "type": "string",
                    "enum": [
                      "doubao-seedream-5-0-pro-260628",
                      "doubao-seedream-5-0-260128",
                      "doubao-seedream-5-0-lite-260128",
                      "doubao-seedream-4-0-250828",
                      "doubao-seedream-4-5-251128"
                    ],
                    "description": "Full model ID. Seedream 5.0 Pro supports single-image generation, precise editing, transparent backgrounds, and layer decomposition; Seedream 5.0 Lite supports single or sequential images, streaming, and web search."
                  },
                  "prompt": {
                    "rank": 20,
                    "type": "string",
                    "example": "a white siamese cat",
                    "description": "Generation or editing prompt. Optional only for Seedream 5.0 Pro layer decomposition, where omission automatically decomposes the main elements."
                  },
                  "image": {
                    "rank": 30,
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 14
                      }
                    ],
                    "description": "One reference image URL/base64 string or an array. Pro accepts up to 10 images in regular mode and exactly one for decomposition; Lite/4.x accept up to 14. Each image must be at most 30 MB."
                  },
                  "size": {
                    "rank": 40,
                    "type": "string",
                    "example": "2K",
                    "description": "Output size. Pro supports 1K/1.5K/2K or valid dimensions; decomposition also supports auto. Lite supports 2K/3K/4K or valid dimensions.",
                    "pattern": "^(1K|1\\.5K|2K|3K|4K|auto|[0-9]+x[0-9]+)$"
                  },
                  "sequential_image_generation": {
                    "rank": 60,
                    "type": "string",
                    "enum": [
                      "auto",
                      "disabled"
                    ],
                    "description": "Sequential image mode. auto lets supported Lite/4.x models generate a related set; disabled returns one image. Not supported by Pro."
                  },
                  "sequential_image_generation_options": {
                    "rank": 61,
                    "type": "object",
                    "properties": {
                      "max_images": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15,
                        "description": "本次请求最多生成的图像数量，范围 [1, 15]。注意：`（`image` 中的参考图数量）+（本次生成的图像数量）不得超过 15`。"
                      }
                    },
                    "description": "Sequential image options. max_images is 1-15 and input images plus outputs must not exceed 15."
                  },
                  "stream": {
                    "rank": 70,
                    "type": "boolean",
                    "description": "Stream normalized image events. Supported by Lite/4.x only and cannot be combined with async or callback_url.",
                    "x-go-optional-pointer": true
                  },
                  "response_format": {
                    "rank": 90,
                    "type": "string",
                    "description": "Image response format: url or b64_json.",
                    "enum": [
                      "url",
                      "b64_json"
                    ]
                  },
                  "watermark": {
                    "rank": 91,
                    "type": "boolean",
                    "x-go-optional-pointer": true,
                    "description": "Whether to add the AI-generated watermark."
                  },
                  "output_format": {
                    "rank": 92,
                    "type": "string",
                    "enum": [
                      "jpeg",
                      "png"
                    ],
                    "description": "Output image format, jpeg or png. Supported by Seedream 5.0 Pro and Lite."
                  },
                  "tools": {
                    "rank": 93,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "web_search"
                          ]
                        }
                      }
                    },
                    "description": "Model tools. Seedream 5.0 Lite supports web_search."
                  },
                  "optimize_prompt_options": {
                    "rank": 94,
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "standard",
                          "fast"
                        ],
                        "description": "提示词优化模式。`standard` 质量更高但速度较慢；`fast` 速度更快但质量相对较低。"
                      }
                    },
                    "description": "Prompt optimization. Pro supports standard/fast; Lite and 4.5 support standard; 4.0 supports standard/fast."
                  },
                  "callback_url": {
                    "rank": 100,
                    "type": "string",
                    "description": "图像生成完成后的回调 URL，该 URL 须可从公网访问。指定后接口将立即返回，生成结果就绪时会异步推送至此回调地址。"
                  },
                  "async": {
