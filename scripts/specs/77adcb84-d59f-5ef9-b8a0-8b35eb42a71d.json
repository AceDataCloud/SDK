        "parameters": [
          {
            "in": "header",
            "name": "accept",
            "schema": {
              "enum": [
                "application/json"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Specify the format of the response returned by the server. If not specified, the default format is `application/json`."
          },
          {
            "in": "header",
            "name": "model",
            "schema": {
              "enum": [
                "s1",
                "s2-pro",
                "s2.1-pro"
              ],
              "type": "string"
            },
            "required": false,
            "description": "The TTS model used can be `s1` or `s2-pro`, with `s2-pro` as the default."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "rank": 0,
                    "type": "string",
                    "example": "Hello, this is a Fish-Audio-compatible test.",
                    "description": "Text content to be synthesized. Required, must be a non-empty string."
                  },
                  "async": {
                    "rank": 101,
                    "type": "boolean",
                    "description": "Whether to process in asynchronous mode. When set to `true`, the interface immediately returns `task_id`, without the need to provide `callback_url`, and then the result can be obtained by polling the corresponding task query interface; if `callback_url` is also provided, the result will be pushed to that callback address."
                  },
                  "top_p": {
                    "rank": 61,
                    "type": "number",
                    "description": "Top-p nucleus sampling parameter, controls output diversity."
                  },
                  "format": {
                    "enum": [
                      "mp3",
                      "wav",
                      "pcm"
                    ],
                    "rank": 20,
                    "type": "string",
                    "description": "Output audio format, default is `mp3`."
                  },
                  "latency": {
                    "enum": [
                      "normal",
                      "balanced"
                    ],
                    "rank": 40,
                    "type": "string",
                    "description": "Delay mode. The upstream rejects null values, and defaults to `normal` when omitted."
                  },
                  "prosody": {
                    "rank": 80,
                    "type": "object",
                    "description": "Rhythm coverage parameters, forwarded as is to upstream (such as speech rate, volume, etc.)."
                  },
                  "normalize": {
                    "rank": 70,
                    "type": "boolean",
                    "x-go-optional-pointer": true,
                    "description": "Is the input text subjected to text normalization processing by the upstream?"
                  },
                  "references": {
                    "rank": 81,
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "description": "One-shot voice clone reference; cannot be combined with reference_id.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "audio",
                        "text"
                      ],
                      "properties": {
                        "audio": {
                          "type": "string",
                          "format": "uri",
                          "maxLength": 2048,
                          "example": "https://cdn.acedata.cloud/reference-voice.mp3",
                          "description": "Public HTTPS MP3/WAV reference audio URL."
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 10000,
                          "example": "春天的清晨，阳光穿过树叶。",
                          "description": "Exact transcript of the reference audio."
                        }
                      }
                    }
                  },
                  "mp3_bitrate": {
                    "enum": [
                      64,
                      128,
                      192
                    ],
                    "rank": 31,
                    "type": "integer",
                    "description": "MP3 bitrate when `format=mp3`."
                  },
                  "sample_rate": {
                    "rank": 30,
                    "type": "integer",
                    "description": "Output the audio sampling rate (e.g., 16000, 22050, 44100)."
                  },
                  "temperature": {
                    "rank": 60,
                    "type": "number",
                    "description": "Sampling temperature (0.0–1.0). The higher the value, the more diverse the output; the lower the value, the more stable and consistent it is."
                  },
                  "callback_url": {
                    "rank": 100,
                    "type": "string",
                    "description": "Optional callback URL. When specified, the interface immediately returns `{\"task_id\": \"5872ab00-3cf4-4040-a798-8510aaa16756\", \"started_at\": \"2025-05-09T12:34:56.789Z\"}`, and after the upstream call is completed, the final `{audio_url, ...}` result will be pushed to this URL via POST."
                  },
                  "chunk_length": {
                    "rank": 50,
                    "type": "integer",
                    "description": "The chunk length passed to the upstream synthesizer."
                  },
                  "reference_id": {
                    "rank": 10,
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    ],
                    "example": "d7900c21663f485ab63ebdb7e5905036",
                    "description": "Saved/public voice ID; cannot be combined with references."
                  },
                  "max_new_tokens": {
                    "rank": 63,
                    "type": "integer",
                    "description": "Maximum number of new tokens generated."
                  },
                  "min_chunk_length": {
                    "rank": 51,
                    "type": "integer",
                    "description": "Minimum block length."
                  },
                  "repetition_penalty": {
                    "rank": 62,
                    "type": "number",
                    "description": "The repetition penalty coefficient applied during the generation process."
                  }
                }
              }
            }
          },
          "required": true
        }
      }
