{"info": {"title": "Digital Human Videos", "version": "1.0.0", "description": "Generate an offline talking-head video: a face (video/photo) + a voice (audio or cloned voice_id + text) -> a lip-synced MP4. Aligned with /kling/talking-photo and /seedance/videos."}, "paths": {"/digital-human/videos": {"post": {"summary": "Digital Human video generation API \u2014 turn a portrait plus audio or text into a talking-head video.", "security": [{"bearerAuth": []}], "responses": {"200": {"content": {"application/json": {"schema": {"type": "object", "example": {"state": "succeed", "width": 1280, "engine": "latentsync", "height": 720, "success": true, "task_id": "0c0b4d3a-2f1e-4a6b-9c2d-2b3c4d5e6f70", "duration": 17.2, "trace_id": "a9063166-26ed-4451-85b5-54e896817c69", "video_url": "https://cdn.acedata.cloud/634d760216.mp4"}}}}, "description": "OK"}, "400": {"content": {"application/json": {"schema": {"type": "object", "example": {"error": {"code": "bad_request", "message": "video_url is required"}, "trace_id": "..."}}}}, "description": "Bad request"}, "401": {"content": {"application/json": {"schema": {"type": "object", "example": {"error": {"code": "invalid_token", "message": "The specified token is invalid or wrong."}, "trace_id": "..."}}}}, "description": "Unauthorized"}, "403": {"content": {"application/json": {"schema": {"type": "object", "example": {"error": {"code": "used_up", "message": "Your balance is not sufficient for current request."}, "trace_id": "..."}}}}, "description": "Balance"}, "429": {"content": {"application/json": {"schema": {"type": "object", "example": {"error": {"code": "too_many_requests", "message": "You have exceeded the rate limit."}, "trace_id": "..."}}}}, "description": "Rate limit"}, "500": {"content": {"application/json": {"schema": {"type": "object", "example": {"error": {"code": "api_error", "message": "Internal server error."}, "trace_id": "..."}}}}, "description": "Server error"}}, "requestBody": {"content": {"application/json": {"schema": {"type": "object", "required": ["video_url"], "properties": {"text": {"type": "string", "example": "\u5927\u5bb6\u597d\uff0c\u8fd9\u662f\u79bb\u7ebf\u751f\u6210\u7684\u6570\u5b57\u4eba\u3002", "description": "Spoken text -> TTS (requires voice_id)."}, "async": {"type": "boolean", "default": false}, "speed": {"type": "number", "default": 1.0, "description": "Audio tempo multiplier."}, "steps": {"type": "integer", "default": 40, "description": "Diffusion steps (LatentSync)."}, "engine": {"enum": ["latentsync", "heygem"], "type": "string", "default": "latentsync", "description": "latentsync = quality (default); heygem = fast tier."}, "guidance": {"type": "number", "default": 2.0, "description": "Lip-sync strength (LatentSync). Lower loosens sync."}, "seam_fix": {"type": "boolean", "default": true, "description": "Apply the mouth-seam reduction blend."}, "voice_id": {"type": "string", "description": "A cloned voice from POST /digital-human/voices."}, "audio_url": {"type": "string", "description": "Public URL of the driving audio (.wav/.mp3/.m4a). OR supply text(+voice_id)."}, "image_url": {"type": "string", "description": "Public URL of a source face photo (photo-driven path)."}, "video_url": {"type": "string", "example": "https://cdn.acedata.cloud/634d760216.mp4", "description": "Public URL of the source face video (preferred). One of video_url/image_url required."}, "resolution": {"enum": ["720p", "540p"], "type": "string", "default": "720p"}, "callback_url": {"type": "string", "description": "Webhook; if set (or async=true) returns task_id immediately."}}}}}, "required": true}}}}, "openapi": "3.0.1", "servers": [{"url": "https://api.acedata.cloud"}], "components": {"securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}}}}