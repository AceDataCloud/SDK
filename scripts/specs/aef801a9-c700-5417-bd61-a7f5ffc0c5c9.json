          "finished_at": {
            "type": "number",
            "minimum": 0
          },
          "elapsed": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "TripoGenerationsRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "generate"
            ],
            "default": "generate"
