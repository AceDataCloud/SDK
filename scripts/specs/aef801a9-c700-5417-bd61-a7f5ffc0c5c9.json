          },
          "finished_at": {
            "type": "number",
            "minimum": 0
          },
          "elapsed": {
            "type": "number",
            "minimum": 0
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "request": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TripoGenerationsRequest"
              },
              {
                "$ref": "#/components/schemas/TripoModelsRequest"
              },
              {
                "$ref": "#/components/schemas/TripoAnimationsRequest"
              }
            ]
          },
          "response": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "success": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "task_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "trace_id": {
                    "type": "string"
                  },
                  "data": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/TripoModel"
                        },
                        {
                          "$ref": "#/components/schemas/TripoRigCheck"
                        }
                      ]
                    },
                    "minItems": 1
                  },
                  "cost": {
                    "$ref": "#/components/schemas/TripoCost"
                  }
                },
                "required": [
                  "success",
                  "task_id",
                  "trace_id",
                  "data"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "success": {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  },
                  "error": {
                    "$ref": "#/components/schemas/TripoError"
                  },
                  "task_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "trace_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "success",
                  "error",
                  "task_id",
                  "trace_id"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "trace_id",
          "request",
          "created_at",
          "started_at"
        ]
      },
      "TripoErrorResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
