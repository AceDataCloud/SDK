{
  "openapi": "3.0.3",
  "info": {
    "title": "Tripo Task Retrieval API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.acedata.cloud"
    }
  ],
  "paths": {
    "/tripo/tasks": {
      "post": {
        "operationId": "tripo_tasks",
        "summary": "Tripo tasks",
        "description": "Retrieve one or several authorized tasks for free. A completed result is nested under response.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "Tripo"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "action": {
                        "type": "string",
                        "enum": [
                          "retrieve"
                        ],
                        "default": "retrieve"
                      },
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "trace_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "id"
                        ]
                      },
                      {
                        "required": [
                          "trace_id"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "action": {
                        "type": "string",
                        "enum": [
                          "retrieve_batch"
                        ]
                      },
                      "ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "minItems": 1,
                        "maxItems": 100
                      },
                      "trace_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "minItems": 1,
                        "maxItems": 100
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "ids"
                        ]
                      },
                      {
                        "required": [
                          "trace_ids"
                        ]
                      }
                    ],
                    "required": [
                      "action"
                    ]
                  }
                ]
              },
              "example": {
                "action": "retrieve",
                "id": "0dc1fbad-1bb2-4ee3-a931-ead28fc16fcd"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task record, batch or empty object",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TripoTask"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "oneOf": [
                              {
                                "$ref": "#/components/schemas/TripoTask"
                              },
                              {
                                "type": "object",
                                "nullable": true,
                                "enum": [
                                  null
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "description": "Matches input order; an unknown or inaccessible ID has a null entry."
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "items",
                        "count"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {}
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripoErrorResult"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripoErrorResult"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden or content rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripoErrorResult"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripoErrorResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "TripoError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "TripoModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "format": {
            "type": "string",
            "enum": [
              "GLB",
              "STL",
              "OBJ",
              "FBX",
              "USDZ",
              "3MF"
            ]
          },
          "model_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 8192
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 8192,
            "description": "Optional preview image."
          },
          "container": {
            "type": "string",
            "enum": [
              "ZIP"
            ]
          },
          "normalize_scale": {
            "type": "number"
          },
          "normalize_translation": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "id",
          "format",
          "model_url"
        ]
      },
      "TripoCost": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string"
          },
          "list_amount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "amount",
          "currency"
        ]
      },
      "TripoTask": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "generations",
              "models",
              "animations"
