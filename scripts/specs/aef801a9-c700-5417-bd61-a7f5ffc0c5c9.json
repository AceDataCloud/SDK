              "v3.1-20260211",
              "v3.0-20250812",
              "v2.5-20250123",
              "P1-20260311",
              "P2-20260801"
            ],
            "default": "v3.1-20260211"
          },
          "texture": {
            "type": "string",
            "enum": [
              "none",
              "standard"
            ],
            "default": "standard"
          },
          "async": {
            "type": "boolean",
            "default": false,
            "description": "Return the task ID immediately."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 8192,
            "description": "Receive the final JSON result by HTTPS POST; implies async."
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 8192,
            "description": "Public PNG or JPEG up to 20 MiB."
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 8192,
              "nullable": true
            },
            "minItems": 2,
            "maxItems": 4,
            "description": "Front, left, back, right. Front and at least one other image are required. Use null to skip an optional view."
          }
        },
        "oneOf": [
          {
            "required": [
              "prompt"
            ]
          },
          {
            "required": [
              "image_url"
            ]
          },
          {
            "required": [
              "image_urls"
            ]
          }
        ],
        "description": "Supply exactly one input: prompt, image_url, or image_urls."
      },
