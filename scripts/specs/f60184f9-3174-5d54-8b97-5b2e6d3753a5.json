{
  "openapi": "3.0.0",
  "info": {
    "title": "Kling Goods Studio",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.acedata.cloud"
    }
  ],
  "paths": {
    "/kling/goods-studio": {
      "post": {
        "summary": "Kling Goods Summary",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contents",
                  "settings"
                ],
                "properties": {
                  "contents": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "url"
                          ],
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "ref_image"
                              ]
                            },
                            "url": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "text"
                          ],
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "goods_title"
                              ]
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "text"
                          ],
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "goods_description"
                              ]
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000
                            }
                          }
                        }
                      ]
                    },
                    "description": "Kling Goods Contents"
                  },
                  "settings": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "720p",
                          "1080p"
                        ],
                        "default": "720p"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "9:16",
                          "1:1",
                          "16:9"
                        ]
                      },
                      "duration": {
                        "type": "integer",
                        "enum": [
                          15,
                          30,
                          60
                        ]
                      }
                    },
                    "required": [
                      "aspect_ratio",
                      "duration"
                    ]
                  },
                  "watermark": {
                    "type": "boolean",
                    "description": "Kling Goods Watermark"
                  },
                  "async": {
                    "type": "boolean",
                    "default": false,
                    "description": "Kling Goods Async"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Kling Goods Callback"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kling Goods Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "task_id": {
                      "type": "string"
                    },
                    "trace_id": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "image",
                              "video"
                            ]
                          },
                          "image_url": {
                            "type": "string"
                          },
                          "video_url": {
                            "type": "string"
                          },
                          "watermark_url": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "seconds": {
                          "type": "number",
                          "readOnly": true
                        },
                        "image_count": {
                          "type": "integer",
                          "readOnly": true
                        },
                        "pricing_tier": {
                          "type": "string",
                          "readOnly": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "kling_create_goods_studio"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
