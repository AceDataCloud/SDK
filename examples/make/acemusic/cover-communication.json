{
  "url": "/acemusic/audios",
  "method": "POST",
  "type": "json",
  "body": {
    "action": "cover",
    "model": "acemusic-v1.1",
    "async": true,
    "audio_id": "{{parameters.audio_id}}",
    "lyric": "{{parameters.lyric}}",
    "style": "{{parameters.style}}",
    "audio_influence": "{{parameters.audio_influence}}"
  },
  "log": {
    "sanitize": [
      "request.headers.authorization",
      "response.body.request",
      "response.body.items"
    ]
  },
  "response": {
    "valid": {
      "condition": "{{!body.error && body.success !== false && body.task_id}}",
      "message": "No ACE Music task ID. Check history before submitting again.",
      "type": "RuntimeError"
    },
    "output": {
      "task_id": "{{body.task_id}}",
      "status": "pending",
      "success": false,
      "trace_id": "{{body.trace_id}}"
    }
  }
}
