{
  "url": "https://api.acedata.cloud/v1/models",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer {{parameters.apiKey}}"
  },
  "response": {
    "valid": "{{!body.error && statusCode === 200 && body.object === 'list'}}",
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.error.message, 'Cannot verify the AceDataCloud token')}}"
    }
  },
  "log": {
    "sanitize": ["request.headers.authorization"]
  }
}
