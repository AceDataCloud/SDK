{
  "testId": "ace-music-track-import",
  "name": "Ace Media",
  "version": "0.2.0",
  "manifestVersion": 2,
  "requirements": {
    "apps": [
      {
        "name": "Express",
        "apiVersion": 1
      }
    ]
  },
  "entryPoints": [
    {
      "type": "panel",
      "id": "audio",
      "main": "index.html",
      "permissions": {
        "sandbox": [
          "allow-popups",
          "allow-popups-to-escape-sandbox"
        ]
      }
    }
  ]
}
